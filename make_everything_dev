#!/bin/bash

################################################################################
#                                                                              #
#                                  IMPORTANT                                   #
#                                                                              #
# This script is intended for developers to create quick builds, default       #
# parameters all reflect this purpose. Please refrain from using this script   #
# before reading through and understanding this script.                        #
#                                                                              #
################################################################################

# Accepted input arguments:
# release/debug:    optional, indicate 'release' or 'debug' to build that
#                   version. This is ignored when building for WIN32, in that 
#                   case 'release' is always used.
# notest:           optional, skip SiQAD unit tests
# -- [CMake args]:  optional, pass additional arguments without shell splitting

# Accepted ENV variables:
# FOR_OS:           win64 or win32 for cross compilation
# QMAKE_COMMAND:    qmake binary path, mostly intended for cross compilation
# CMAKE_COMMAND:    cmake binary path, mostly intended for cross compilation
# APPEND_TO_PATH:   additional paths that should be appended to PATH, intended 
#                   for cross compilation. If FOR_OS==win64 and APPEND_TO_PATH 
#                   is empty, this script automatically adds /opt/mxe/usr/bin to 
#                   APPEND_TO_PATH if it exists.. Set an empty APPEND_TO_PATH 
#                   that is not desired.
# CMAKE_FLAGS:      cmake flags
# JOBS:             optional, positive number of parallel build jobs


set -eo pipefail

#swig=false
build_type="Debug"
install_prefix="debug"
skip_tests=false
cmake_args=()
for arg in "$@"; do
    case "$arg" in
        #("--swig")  swig=true ;;
        ("release") build_type="Release"; install_prefix="release" ;;
        ("debug")   build_type="Debug"; install_prefix="debug" ;;
        ("notest")  skip_tests=true ;;
        ("--") break ;;
        ("-h"|"--help")
            echo "Usage: $0 [debug|release] [notest] [-- CMake arguments...]"
            exit 0 ;;
        (*) echo "Unknown argument: $arg" >&2; exit 2 ;;
    esac
    shift
done
if [[ ${1:-} == -- ]]; then
    shift
    cmake_args=("$@")
fi

# Determine number of logical cores to use for compilation
cpu_cores=${JOBS:-}
host_os=$(uname)
if [[ -z $cpu_cores ]]; then
    cpu_cores=1
    if [[ $host_os == "Darwin" ]]; then
        cpu_cores=$(sysctl -n hw.logicalcpu)
    elif [[ $host_os == "Linux" ]]; then
        cpu_cores=$(getconf _NPROCESSORS_ONLN)
    fi
fi
if [[ ! $cpu_cores =~ ^[1-9][0-9]*$ ]]; then
    echo "JOBS must be a positive integer." >&2
    exit 2
fi

proj_root=$(cd "$(dirname "$0")" && pwd)
target_os=${FOR_OS:-}

if [ "$target_os" == "win64" ]; then
    build_dir="${proj_root}/build-x64"
elif [ "$target_os" == "win32" ]; then
    build_dir="${proj_root}/build-i686"
else
    build_dir="${proj_root}/build"
fi

# Path to Breeze Qt icon theme for cross-compilation
# An example is to clone https://github.com/KDE/breeze-icons and point the following variable to the icons directory.
#qt_theme_path=$HOME/global/siqad-cross-compilation-resources/breeze-icons/icons

if [[ -n ${APPEND_TO_PATH+x} ]]; then
    if [[ -n $APPEND_TO_PATH ]]; then
        export PATH="$PATH:$APPEND_TO_PATH"
    fi
elif [[ "$target_os" == "win64" ]] || [[ "$target_os" == "win32" ]]; then
    MXE_PATH=/opt/mxe/usr/bin
    if [ -d "${MXE_PATH}" ]; then
        export PATH="$PATH:$MXE_PATH"
    fi
fi


cmake_command=${CMAKE_COMMAND:-cmake}
platform_args=()
if [[ $target_os == win64 || $target_os == win32 ]]; then
    build_type=Release
    install_prefix=release
    if [[ $target_os == win64 ]]; then
        mxe_triplet=x86_64-w64-mingw32.static
    else
        mxe_triplet=i686-w64-mingw32.static
    fi
    cmake_command=${CMAKE_COMMAND:-/opt/mxe/usr/bin/$mxe_triplet-cmake}
    platform_args+=("-DWIN32_QMAKE_BIN=${QMAKE_COMMAND:-/opt/mxe/usr/bin/$mxe_triplet-qmake-qt5}"
                    "-DWIN32_MAKE_BIN=make")
elif [[ $host_os == Darwin ]]; then
    # Keep CMake's dependency search and Clang on the same selected Apple SDK.
    # Rediscover SDK-dependent cache entries after Xcode/CLT changes.
    macos_sdk=${SDKROOT:-$(xcrun --sdk macosx --show-sdk-path)}
    platform_args+=("-DCMAKE_OSX_SYSROOT=$macos_sdk" "-UCUPS_*" "-UOPENGL_*")
fi

# Retain the legacy whitespace-separated environment flags. For values with
# spaces, use arguments after -- instead; no eval or command substitution.
extra_flags=()
if [[ -n ${CMAKE_FLAGS:-} ]]; then
    while IFS= read -r flag_line || [[ -n $flag_line ]]; do
        read -r -a line_flags <<< "$flag_line"
        extra_flags+=("${line_flags[@]}")
    done <<< "$CMAKE_FLAGS"
fi
if [[ $skip_tests == true ]]; then
    cmake_args+=("-DBUILD_TESTING=OFF")
fi

# Normalize legacy flags and detect the effective test option in argument order.
for flag_set in extra_flags cmake_args; do
    # Bash 3.2 has no namerefs; keep parsing explicit and avoid eval.
    normalized=()
    if [[ $flag_set == extra_flags ]]; then
        flags=("${extra_flags[@]}")
    else
        flags=("${cmake_args[@]}")
    fi
    for flag in "${flags[@]}"; do
        case "$flag" in
            -DBUILD_TEST=*|-DBUILD_TEST:BOOL=*) flag="-DBUILD_TESTING=${flag#*=}" ;;
            -DSKIP_SIQAD_TESTS=*|-DSKIP_SIQAD_TESTS:BOOL=*)
                case "${flag#*=}" in
                    [Oo][Nn]|[Tt][Rr][Uu][Ee]|1|[Yy][Ee][Ss]|[Yy]) flag=-DBUILD_TESTING=OFF ;;
                    [Oo][Ff][Ff]|[Ff][Aa][Ll][Ss][Ee]|0|[Nn][Oo]|[Nn]|[Ii][Gg][Nn][Oo][Rr][Ee]|[Nn][Oo][Tt][Ff][Oo][Uu][Nn][Dd]|*-NOTFOUND|"") flag=-DBUILD_TESTING=ON ;;
                    (*) flag=-DBUILD_TESTING=OFF ;;
                esac ;;
        esac
        normalized+=("$flag")
    done
    if [[ $flag_set == extra_flags ]]; then
        extra_flags=("${normalized[@]}")
    else
        cmake_args=("${normalized[@]}")
    fi
done

echo "Project root:"
echo "$proj_root"

echo "CMake directory:"
echo "$build_dir"

# Make and install SiQADConn via scikit and SWIG
# NOTE this is now integrated into the normal CMake routine
#if [[ $swig == true ]] && [[ "$FOR_OS" != "win64" ]]; then
#    echo "Building SWIG SiQADConnector at central location..."
#    cd "${proj_root}/libs/siqadconn"
#    ./swig_compile_and_install
#fi

# use cmake to create Makefiles for the project
echo "Running cmake..."
# Recompute derived install roots when debug/release or the prefix changes.
# Explicit overrides in CMAKE_FLAGS or arguments after -- still take precedence.
"$cmake_command" -S "$proj_root" -B "$build_dir" \
    -U SIQAD_INSTALL_ROOT -U SIQAD_PLUGINS_ROOT -U SIQAD_LIBS_ROOT -U SIQADCONN_ROOT \
    "-DCMAKE_BUILD_TYPE=$build_type" "-DCMAKE_INSTALL_PREFIX=$build_dir/$install_prefix" \
    -U BUILD_TEST -U SKIP_SIQAD_TESTS \
    -DBUILD_TESTING=ON "${platform_args[@]}" "${extra_flags[@]}" "${cmake_args[@]}"

# compile
echo "Building everything..."
"$cmake_command" --build "$build_dir" --config "$build_type" --parallel "$cpu_cores"
# Read the effective option from CMake, including typed and command-line overrides.
if /usr/bin/grep -Eiq '^BUILD_TESTING:[^=]+=(ON|TRUE|1|YES|Y)$' "$build_dir/CMakeCache.txt"; then
    "${CTEST_COMMAND:-ctest}" --test-dir "$build_dir" -C "$build_type" --output-on-failure --no-tests=error
fi
"$cmake_command" --install "$build_dir" --config "$build_type"
