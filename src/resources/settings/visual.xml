<?xml version="1.0" encoding="UTF-8"?>
<!--Doesn't matter what the default values in the fields are, they will be overwritten during runtime-->
<properties map_label="Visual">
    <zoom_min>
        <T>float</T>
        <val></val>
        <dp>5</dp>
        <label>Minimum zoom factor</label>
        <tip>Farthest zoom extent.</tip>
        <meta>
            <category>GUI</category>
            <key>view/zoom_min</key>
        </meta>
    </zoom_min>
    <zoom_max>
        <T>float</T>
        <val></val>
        <label>Maximum zoom factor</label>
        <tip>Closest zoom extent.</tip>
        <meta>
            <category>GUI</category>
            <key>view/zoom_max</key>
        </meta>
    </zoom_max>
    <screenshot_px_per_ang>
        <T>float</T>
        <val></val>
        <label>Screenshot pixels per angs</label>
        <tip>Pixels per angstrom when taking an svg screenshot (requires restart).</tip>
        <meta>
            <category>GUI</category>
            <key>view/screenshot_px_per_ang</key>
        </meta>
    </screenshot_px_per_ang>
    <scroll_direction>
        <T>string</T>
        <val>default</val>
        <label>Scroll direction</label>
        <tip>Choose how touchpad and mouse wheel scrolling moves the view. Default follows the operating system preference.</tip>
        <value_selection type="ComboBox">
            <default>Default</default>
            <invert_x>Inverse X</invert_x>
            <invert_y>Inverse Y</invert_y>
            <invert_xy>Inverse X &amp; Y</invert_xy>
        </value_selection>
        <meta>
            <category>GUI</category>
            <key>view/scroll_direction</key>
        </meta>
    </scroll_direction>
</properties>
