<?xml version='1.0' encoding='UTF-8'?>
<siqad>
  <program>
    <version>0.2.1</version>
  </program>
  <gui>
    <zoom>0.15</zoom>
    <scroll x="0" y="0" />
  </gui>
  <layers>
    <layer_prop>
      <name>Lattice</name>
      <type>Lattice</type>
      <zoffset>0</zoffset>
      <zheight>0</zheight>
      <visible>1</visible>
      <active>1</active>
    </layer_prop>
    <layer_prop>
      <name>Surface</name>
      <type>DB</type>
      <zoffset>0</zoffset>
      <zheight>0</zheight>
      <visible>1</visible>
      <active>1</active>
    </layer_prop>
    <layer_prop>
      <name>Metal</name>
      <type>Electrode</type>
      <zoffset>12</zoffset>
      <zheight>3</zheight>
      <visible>1</visible>
      <active>1</active>
    </layer_prop>
  </layers>
  <design>
    <layer type="Lattice" />
    <layer type="DB">
      <aggregate>
        <aggregate>
          <dbdot>
            <layer_id>1</layer_id>
            <latcoord n="-1" m="-1" l="1" />
            <physloc x="-3.84" y="-5.43" />
            <color>#ff445566</color>
          </dbdot>
          <dbdot>
            <layer_id>1</layer_id>
            <latcoord n="3" m="0" l="1" />
            <physloc x="11.52" y="2.25" />
            <color>#ff778899</color>
          </dbdot>
        </aggregate>
        <dbdot>
          <layer_id>1</layer_id>
          <latcoord n="0" m="0" l="0" />
          <physloc x="0" y="0" />
          <color>#ff112233</color>
        </dbdot>
      </aggregate>
    </layer>
    <layer type="Electrode" />
  </design>
</siqad>
